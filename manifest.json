{
    "manifest_version": 3,
    "name": "Uni Session Keeper Pro",
    "version": "1.2",
    "author": "Monowar Husain",
    "description": "Maintains Google Workspace active sessions for institutional accounts.",
    "permissions": [
        "alarms",
        "storage",
        "notifications"
    ],
    "host_permissions": [
        "https://mail.google.com/*",
        "https://accounts.google.com/*"
    ],
    "action": {
        "default_popup": "popup.html"
    },
    "background": {
        "service_worker": "background.js"
    }
}